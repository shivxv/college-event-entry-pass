PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/college_event_entry_pass
# Generate a random secret of at least 32 characters for JWT signing.
JWT_SECRET=
# Generate a separate one-time bootstrap token; clear it after creating the first admin.
BOOTSTRAP_ADMIN_TOKEN=
# Optional ISO date shared by both parties, for example 2026-11-20
EVENT_DATE=
CLIENT_ORIGIN=http://localhost:5173
# Set the public HTTPS API origin used inside pass QR verification URLs in production.
PUBLIC_API_URL=
# Configure SMTP credentials for staff invitations and password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
